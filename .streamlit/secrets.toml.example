# Copy this file to secrets.toml and fill in your AWS credentials.
# secrets.toml is in .gitignore and will NOT be committed to git.
# On Streamlit Cloud, paste these values into App Settings → Secrets instead.

[aws]
access_key_id     = "YOUR_AWS_ACCESS_KEY_ID"
secret_access_key = "YOUR_AWS_SECRET_ACCESS_KEY"
region            = "us-east-1"
