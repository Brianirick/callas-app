{
  "type": "finishing",
  "name": "HG-Mesh-bleed-cp",
  "description": "Mesh H&G finishing (full size, matches production KFPX): outline fonts, remap rich blacks to 100K to 100K, 1\" bleed, 2pt CropBox spot stroke. Grommets come from the per-size cutpath (impose_cutpath).",
  "steps": [
    {
      "op": "outline_fonts"
    },
    {
      "op": "adjust_black_vectors",
      "params": {
        "target": "0-0-0-100"
      }
    },
    {
      "op": "set_mediabox_to_origin"
    },
    {
      "op": "enlarge_page",
      "params": {
        "top_inch": 1.0,
        "bottom_inch": 1.0,
        "left_inch": 1.0,
        "right_inch": 1.0,
        "update_trimbox": false
      }
    },
    {
      "op": "set_mediabox_to_origin"
    },
    {
      "op": "add_cropbox_stroke",
      "params": {
        "stroke_width_pt": 2.0
      }
    }
  ]
}
