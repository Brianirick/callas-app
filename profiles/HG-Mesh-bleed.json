{
  "type": "finishing",
  "name": "HG-Mesh-bleed",
  "description": "Mesh H&G (legacy, python-placed grommets): outline fonts, remap rich blacks to 100K, 1\" bleed, 2pt CropBox spot stroke, grommets added in code. Production recipes use HG-Mesh-bleed-cp.",
  "steps": [
    {
      "op": "outline_fonts"
    },
    {
      "op": "adjust_black_vectors",
      "params": {
        "target": "0-0-0-100"
      }
    },
    {
      "op": "set_mediabox_to_origin"
    },
    {
      "op": "enlarge_page",
      "params": {
        "top_inch": 1.0,
        "bottom_inch": 1.0,
        "left_inch": 1.0,
        "right_inch": 1.0,
        "update_trimbox": false
      }
    },
    {
      "op": "set_mediabox_to_origin"
    },
    {
      "op": "add_cropbox_stroke",
      "params": {
        "stroke_width_pt": 2.0
      }
    },
    {
      "op": "add_grommets",
      "params": {
        "grommet_file": "grommet.pdf",
        "n_across": 6,
        "inset_in": 0.52,
        "y_inset_in": 0.5,
        "corner_offset_in": 4.0,
        "grommet_size_pt": 10,
        "triple_corners": true
      }
    }
  ]
}
