{
  "type": "finishing",
  "name": "HG-Mesh-bleed",
  "description": "Mesh H&G finishing (full size): remap black, outline fonts, 1\" bleed, trim fold stroke, thrucut spot",
  "steps": [
    {
      "op": "set_mediabox_to_origin"
    },
    {
      "op": "outline_fonts"
    },
    {
      "op": "adjust_black_vectors"
    },
    {
      "op": "enlarge_page",
      "params": {
        "top_inch": 1.0,
        "bottom_inch": 1.0,
        "left_inch": 1.0,
        "right_inch": 1.0,
        "update_trimbox": false
      }
    },
    {
      "op": "set_mediabox_to_origin"
    },
    {
      "op": "add_trimbox_stroke"
    },
    {
      "op": "add_thrucut_spot"
    },
    {
      "op": "add_grommets",
      "params": {
        "grommet_file": "grommet.pdf",
        "n_across": 6,
        "inset_in": 0.52,
        "y_inset_in": 0.5,
        "corner_offset_in": 4.0,
        "grommet_size_pt": 10,
        "triple_corners": true
      }
    }
  ]
}