{
  "type": "finishing",
  "name": "HG-Mesh-halfsize",
  "description": "Mesh H&G finishing (half-size art, 15/20ft): outline fonts, remap rich blacks to 100K, 0.5\" bleed, scale 2x (UserUnit), 2pt CropBox spot stroke.",
  "steps": [
    {
      "op": "outline_fonts"
    },
    {
      "op": "adjust_black_vectors",
      "params": {
        "target": "0-0-0-100"
      }
    },
    {
      "op": "set_mediabox_to_origin"
    },
    {
      "op": "enlarge_page",
      "params": {
        "top_inch": 0.5,
        "bottom_inch": 0.5,
        "left_inch": 0.5,
        "right_inch": 0.5,
        "update_trimbox": false
      }
    },
    {
      "op": "set_mediabox_to_origin"
    },
    {
      "op": "scale_pages",
      "params": {
        "scale_percent": "200"
      }
    },
    {
      "op": "add_cropbox_stroke",
      "params": {
        "stroke_width_pt": 2.0
      }
    }
  ]
}
