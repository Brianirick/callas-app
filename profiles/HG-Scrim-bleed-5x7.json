{
  "type": "finishing",
  "name": "HG-Scrim-bleed-5x7",
  "description": "Scrim H&G (5x7): 1pt CropBox stroke plus 0.25pt trim-line stroke, as in Scrim-hem-grom-5x7-finish-V3.kfpx.",
  "steps": [
    {
      "op": "outline_fonts"
    },
    {
      "op": "set_mediabox_to_origin"
    },
    {
      "op": "enlarge_page",
      "params": {
        "top_inch": 1.0,
        "bottom_inch": 1.0,
        "left_inch": 1.0,
        "right_inch": 1.0,
        "update_trimbox": false
      }
    },
    {
      "op": "set_mediabox_to_origin"
    },
    {
      "op": "add_trimbox_stroke"
    },
    {
      "op": "add_cropbox_stroke",
      "params": {
        "stroke_width_pt": 1.0
      }
    }
  ]
}
