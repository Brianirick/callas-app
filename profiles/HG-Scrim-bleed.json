{
  "type": "finishing",
  "name": "HG-Scrim-bleed",
  "description": "Scrim H&G finishing (matches production KFPX): outline fonts, 1\" bleed all sides, 2pt CropBox spot stroke. Grommets/thru-cut come from the per-size cutpath (impose_cutpath).",
  "steps": [
    {
      "op": "outline_fonts"
    },
    {
      "op": "set_mediabox_to_origin"
    },
    {
      "op": "enlarge_page",
      "params": {
        "top_inch": 1.0,
        "bottom_inch": 1.0,
        "left_inch": 1.0,
        "right_inch": 1.0,
        "update_trimbox": false
      }
    },
    {
      "op": "set_mediabox_to_origin"
    },
    {
      "op": "add_cropbox_stroke",
      "params": {
        "stroke_width_pt": 2.0
      }
    }
  ]
}
